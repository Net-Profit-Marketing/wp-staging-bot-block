<?xml version="1.0"?>
<ruleset name="Staging Bot Block">
  <description>Runtime WordPress standards and PHP 7.4+ compatibility.</description>
  <file>staging-bot-block.php</file>
  <file>uninstall.php</file>
  <file>include</file>
  <file>setting-page</file>
  <arg name="extensions" value="php"/>
  <arg value="ps"/>
  <config name="minimum_wp_version" value="6.8"/>
  <config name="testVersion" value="7.4-"/>
  <rule ref="WordPress"/>
  <rule ref="PHPCompatibilityWP"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="staging-bot-block"/>
      </property>
    </properties>
  </rule>
</ruleset>
